<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Floating Recorder"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lightweight floating bar that draws over all apps."
        android:layout_marginBottom="24dp"
        android:gravity="center" />

    <Button
        android:id="@+id/btn_start_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Launch Floating Overlay Bar"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_stop_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop Overlay" />
</LinearLayout>