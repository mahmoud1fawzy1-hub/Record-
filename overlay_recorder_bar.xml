<?xml version="1.0" encoding="utf-8"?>
<!-- Simple un-styled floating overlay bar with 3 buttons: Record, Pause, Finish/Preview -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#DD212121"
    android:padding="6dp"
    android:elevation="8dp">

    <!-- Draggable grip handle -->
    <View
        android:id="@+id/drag_handle"
        android:layout_width="16dp"
        android:layout_height="36dp"
        android:background="#44888888"
        android:layout_marginEnd="6dp" />

    <!-- Button 1: Record -->
    <Button
        android:id="@+id/btn_record"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:text="Record"
        android:textSize="12sp"
        android:minWidth="64dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:backgroundTint="#D32F2F"
        android:textColor="#FFFFFF" />

    <!-- Button 2: Pause -->
    <Button
        android:id="@+id/btn_pause"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:text="Pause"
        android:textSize="12sp"
        android:minWidth="60dp"
        android:layout_marginStart="4dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:backgroundTint="#424242"
        android:textColor="#FFFFFF" />

    <!-- Button 3: Finish / Preview -->
    <Button
        android:id="@+id/btn_finish_preview"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:text="Finish / Preview"
        android:textSize="12sp"
        android:minWidth="90dp"
        android:layout_marginStart="4dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:backgroundTint="#1976D2"
        android:textColor="#FFFFFF" />

    <!-- Status indicator text -->
    <TextView
        android:id="@+id/tv_status_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ready"
        android:textSize="11sp"
        android:textColor="#BBBBBB"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp" />

    <!-- Dismiss close button (X) -->
    <Button
        android:id="@+id/btn_close_overlay"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:text="✕"
        android:textSize="12sp"
        android:padding="0dp"
        android:backgroundTint="#333333"
        android:textColor="#999999" />

</LinearLayout>